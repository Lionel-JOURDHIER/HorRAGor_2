# Dockerfile.api
# Image pour l'API FastAPI + couche agents LangGraph

FROM python:3.11-slim

# Variables d'environnement de build
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Installation des dépendances système (curl pour healthcheck, build-essential
# pour faiss, libpq-dev pour la compilation de psycopg2 depuis les sources)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Installation de uv (gestionnaire de paquets)
RUN pip install --no-cache-dir uv

# Copie des fichiers de dépendances du package api — on copie d'abord pour
# profiter du cache Docker si le code change mais pas les deps.
# Le code de agents/ tourne dans ce même processus (import direct via
# PYTHONPATH, pas de paquet installé séparément) : ses dépendances runtime
# sont déjà couvertes par api/pyproject.toml, qui en est un sur-ensemble
# (langgraph, langchain-ollama, faiss-cpu, loguru, pgvector...).
COPY api/pyproject.toml api/uv.lock ./api/

# Installe depuis le lock, sans installer le paquet "api" lui-même (le code
# n'est pas encore copié à cette étape, et n'a pas besoin d'être un paquet
# installé : PYTHONPATH=/app suffit à l'importer).
RUN uv sync --project api --frozen --no-dev --no-install-project

# Copie du code source complet
COPY . .

EXPOSE 8000

CMD ["uv", "run", "--project", "api", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]